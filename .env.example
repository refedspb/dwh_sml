# --- PostgreSQL (источник и DWH живут в одном инстансе, разные схемы) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deals_bigdata
# Порт на хосте (только 127.0.0.1); внутри сети compose Postgres слушает 5432
PG_PORT=55432

# --- Генератор источника ---
N_PRICES=300000

# --- Пайплайн ---
# Дата снимка: НЕ системная дата. Границы train/test и фильтры витрин считаются от неё.
AS_OF=2026-10-26
# Окно ETL по prices.loading_date (пусто = полная загрузка). Формат YYYY-MM-DD.
START_DATE=
END_DATE=
# Считаем постоянным сид=42
RANDOM_SEED=42
# catboost (основная), ridge и tree (бейзлайны); первая в списке используется для скоринга
ML_MODELS=catboost,ridge,tree

# --- Extra (docker compose --profile extra up). Порты на хосте нестандартные, чтобы не конфликтовать с локальными службами ---
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics
CLICKHOUSE_DB=analytics
CLICKHOUSE_HTTP_PORT=18123
# 1 = задача DAG sync_clickhouse выполняется (нужен запущенный профиль clickhouse), 0 = пропускается
ENABLE_CLICKHOUSE_SYNC=0
AIRFLOW_PORT=18080
SUPERSET_PORT=18088
