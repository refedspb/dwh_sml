# Airflow для оркестрации (extra). Зависимости проекта ставятся в ОТДЕЛЬНЫЙ venv, чтобы не конфликтовать
# с пакетами самого Airflow; DAG вызывает задачи через /opt/airflow/venv/bin/python.
FROM apache/airflow:2.10.5-python3.11

USER airflow
COPY --chown=airflow:root requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/airflow/venv \
    && /opt/airflow/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt
