# Superset с драйвером PostgreSQL (в базовом образе его нет) и скриптом наполнения дашборда.
FROM apache/superset:4.1.2

USER root
RUN pip install --no-cache-dir psycopg2-binary==2.9.10
USER superset

COPY --chown=superset:superset extra/superset_config.py /app/pythonpath/superset_config.py
COPY --chown=superset:superset extra/superset_bootstrap.py /app/bootstrap.py
ENV SUPERSET_CONFIG_PATH=/app/pythonpath/superset_config.py
